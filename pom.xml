import io.restassured.RestAssured;
        import io.restassured.filter.log.RequestLoggingFilter;
        import io.restassured.filter.log.ResponseLoggingFilter;
        import io.restassured.response.Response;
        import org.junit.jupiter.api.*;
        import org.junit.jupiter.api.TestInfo;

        import java.io.ByteArrayOutputStream;
        import java.io.PrintStream;

        import static org.junit.jupiter.api.Assertions.*;

        public class PostmanEchoTests {

        private static ByteArrayOutputStream logOutput;

        @BeforeAll
        public static void setup() {
        // Настройка "тихого" режима RestAssured
        logOutput = new ByteArrayOutputStream();
        PrintStream printStream = new PrintStream(logOutput);

        RestAssured.baseURI = "https://postman-echo.com";
        RestAssured.filters(
        new RequestLoggingFilter(printStream),
        new ResponseLoggingFilter(printStream)
        );

        System.out.println("╔══════════════════════════════╗");
        System.out.println("║   НАЧАЛО ТЕСТИРОВАНИЯ       ║");
        System.out.println("╚══════════════════════════════╝");
        }

        @AfterEach
        public void printLogs() {
        // Вывод логов только если тест упал
        if (logOutput.size() > 0) {
        System.out.println("\n[Детали запроса]");
        System.out.println(logOutput.toString());
        logOutput.reset();
        }
        }

        @Test
        @DisplayName("GET запрос")
        void testGetRequest(TestInfo testInfo) {
        printTestHeader(testInfo);

        Response response = RestAssured.given()
        .get("/get?foo=bar");

        assertEquals(200, response.getStatusCode());
        System.out.println("✅ GET тест выполнен успешно");
        }

        private void printTestHeader(TestInfo testInfo) {
        System.out.println("\n──────────────────────────────");
        System.out.println("🚀 Тест: " + testInfo.getDisplayName());
        System.out.println("──────────────────────────────");
        }
        }